generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectVisibility {
  PRIVATE
  INVITE_ONLY
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  username     String          @unique @db.VarChar(40)
  email        String          @unique @db.VarChar(254)
  passwordHash String          @map("password_hash") @db.Text
  avatarUrl    String?         @map("avatar_url") @db.Text
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  sessions     Session[]
  ownedProjects Project[]      @relation("ProjectOwner")
  memberships  ProjectMember[]
  messages     ChatMessage[]
  snapshots    DocumentSnapshot[] @relation("SnapshotCreator")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Text
  userId    String   @db.Uuid @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Project {
  id          String            @id @default(uuid()) @db.Uuid
  ownerId     String            @db.Uuid @map("owner_id")
  name        String            @db.VarChar(80)
  description String            @default("") @db.VarChar(500)
  visibility  ProjectVisibility @default(PRIVATE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  owner       User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  files       ProjectFile[]
  rooms       Room[]

  @@index([ownerId, updatedAt])
  @@map("projects")
}

model ProjectMember {
  projectId String      @db.Uuid @map("project_id")
  userId    String      @db.Uuid @map("user_id")
  role      ProjectRole @default(EDITOR)
  joinedAt  DateTime    @default(now()) @map("joined_at")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, joinedAt])
  @@map("project_members")
}

model ProjectFile {
  id        String             @id @default(uuid()) @db.Uuid
  projectId String             @db.Uuid @map("project_id")
  parentId  String?            @db.Uuid @map("parent_id")
  name      String             @db.VarChar(255)
  path      String             @db.VarChar(1024)
  isFolder  Boolean            @default(false) @map("is_folder")
  language  String             @default("plaintext") @db.VarChar(40)
  content   String             @default("") @db.Text
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ProjectFile?       @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectFile[]      @relation("FileTree")
  snapshots DocumentSnapshot[]

  @@unique([projectId, path])
  @@index([projectId, parentId])
  @@map("project_files")
}

model Room {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid @map("project_id")
  createdById String        @db.Uuid @map("created_by_id")
  inviteHash  String?       @unique @map("invite_hash") @db.Text
  expiresAt   DateTime?     @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@index([projectId])
  @@map("rooms")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid @map("room_id")
  senderId  String   @db.Uuid @map("sender_id")
  content   String   @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model DocumentSnapshot {
  id             String      @id @default(uuid()) @db.Uuid
  projectFileId  String      @db.Uuid @map("project_file_id")
  version        Int
  state          Bytes       @db.ByteA
  createdById    String?     @db.Uuid @map("created_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  projectFile    ProjectFile @relation(fields: [projectFileId], references: [id], onDelete: Cascade)
  createdBy      User?       @relation("SnapshotCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectFileId, version])
  @@index([projectFileId, createdAt])
  @@map("document_snapshots")
}
